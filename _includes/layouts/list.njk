---
layout: layouts/base.njk
---
{%- set t = i18n[locale] -%}
<article>
  <h1>{{ title }}</h1>
  <div class="prose" data-search="body" data-search-title="{{ title }}" data-search-summary="{{ summary }}" data-search-keywords="{{ keywords | join(' ') if keywords else '' }}">
    {{ content | safe }}
  </div><!-- /search-body -->
  <ul class="signboard">
    {%- for p in collections.procedures | inLocale(locale) %}
    <li class="priority-{{ p.data.priority or 'normal' }}">
      {%- if p.data.priority == "high" %}<span class="first">{{ t.priorityFirst }}</span>{% endif %}
      <a href="{{ p.url }}">{{ p.data.title }}</a>
      <p>{{ p.data.summary }}</p>
    </li>
    {%- endfor %}
  </ul>
</article>
