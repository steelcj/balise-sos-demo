---
layout: layouts/base.njk
---
{%- set t = i18n[locale] -%}
<article class="print-all">
  <h1>{{ title }}</h1>
  <div class="prose">{{ content | safe }}</div>
  <p class="no-print"><button type="button" data-action="print">{{ t.print }}</button></p>
  <nav class="toc" aria-label="{{ t.allProcedures }}">
    <ol>
      {%- for p in collections.procedures | inLocale(locale) %}
      <li><a href="#{{ p.data.identifier }}">{{ p.data.title }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
  {%- for p in collections.procedures | inLocale(locale) %}
  <section class="procedure printed" id="{{ p.data.identifier }}">
    <h2>{{ p.data.title }}</h2>
    <p class="lede">{{ p.data.summary }}</p>
    <dl class="meta">
      <div><dt>{{ t.responsible }}</dt><dd>{{ p.data.responsible }}</dd></div>
      <div><dt>{{ t.reviewed }}</dt><dd>{{ p.data.reviewed | isoDay }}</dd></div>
      <div><dt>{{ t.version }}</dt><dd>{{ p.data.docVersion }}</dd></div>
    </dl>
    <div class="prose procedure-body demote">{{ p.content | safe }}</div>
  </section>
  {%- endfor %}
</article>
